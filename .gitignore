# Unity specific ignores
[Ll]ibrary/
/[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size
[Mm]emoryCaptures/

# Recordings can get excessive in size
[Rr]ecordings/

# Asset Store tools (optional)
# [Aa]ssets/AssetStoreTools*

# JetBrains Rider plugin (auto-generated)
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VSCode cache
.vs/
.vscode/
.gradle/

# Unity auto-generated project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for debug databases
*.pidb.meta
*.pdb.meta
*.mdb.meta

# System info logs
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.exe
*.dll
*.so
*.dylib

# Crashlytics / build info
crashlytics-build.properties

# Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# Dedicated Server specific data
ServerData/
DedicatedServerConfig/
ServerLogs/
ServerCache/
ServerTemp/

# Local environment or editor settings
*.local
*.swp
*.bak
*.tmp
.DS_Store
Thumbs.db

# Ignore backup folders
[Bb]ackup*/
[Tt]est[Rr]esults*/